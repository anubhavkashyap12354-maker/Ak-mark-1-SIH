{
  "name": "sih-civic-grievance-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo for SIH Civic Grievance Redressal System powered by Groq AI and Supabase",
  "scripts": {
    "dev": "pnpm --recursive --parallel run dev",
    "build": "pnpm --recursive run build",
    "lint": "pnpm --recursive run lint",
    "db:push": "pnpm --filter @sih/database db:push"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "keywords": [
    "civic-grievance",
    "sih",
    "supabase",
    "groq-ai",
    "monorepo"
  ],
  "author": "SIH Team",
  "license": "MIT"
}
